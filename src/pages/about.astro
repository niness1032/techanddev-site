---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../consts';

const facts = [
  { label: 'Legal entity', value: SITE.legalName },
  { label: 'Founded', value: String(SITE.founded) },
  { label: 'Location', value: SITE.location },
  { label: 'Platforms', value: 'Desktop, mobile, web' },
];
---

<Base
  title="About"
  description={`About ${SITE.legalName}, a software development organization registered in Colorado, United States.`}
>
  <PageHeader
    eyebrow="About"
    title="About the company."
    lead={`${SITE.legalName} is a software development organization registered in Colorado, United States.`}
  />

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="grid gap-16 md:grid-cols-3">
      <div
        class="text-muted space-y-6 text-[17px] leading-relaxed md:col-span-2"
      >
        <p>
          The organization works in three areas: software development,
          automation of business processes, and AI agents. We develop our own
          products and take on projects for clients.
        </p>
        <p>
          Development covers desktop and mobile applications as well as web
          services. We handle the whole cycle: requirements, design, build,
          release, and support once the product is live. We are not tied to a
          single platform and choose the technology that fits the task.
        </p>
        <p>
          Automation work usually begins with something a company already does
          by hand every week. We connect the systems that are already in place,
          move data between them and take the repeated steps out of the process.
        </p>
        <p>
          AI agents are the newest of the three areas. We build agents that
          process documents, answer questions from an internal knowledge base
          and prepare incoming requests so that people only deal with the part
          that needs a decision.
        </p>
        <p>
          Alongside client work we develop our own applications. The first of
          them is VPN List, a VPN client for macOS, currently in development.
          Details are on the products page.
        </p>
      </div>

      <aside class="border-line bg-surface/50 h-fit rounded-2xl border p-8">
        <h2
          class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase"
        >
          Company details
        </h2>
        <dl class="mt-6 space-y-5 text-[15px]">
          {
            facts.map((fact) => (
              <div>
                <dt class="text-muted">{fact.label}</dt>
                <dd class="mt-1 font-medium">{fact.value}</dd>
              </div>
            ))
          }
          <div>
            <dt class="text-muted">Contact</dt>
            <dd class="mt-1 font-medium">
              <a
                href={`mailto:${SITE.email}`}
                class="underline underline-offset-4 transition-opacity hover:opacity-60"
                >{SITE.email}</a
              >
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>
