---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { SITE, PRODUCTS } from '../consts';

const services = [
  {
    title: 'Software development',
    body: 'Applications for desktop and mobile, and web services. We take a product from the first draft through to release, and keep supporting it afterwards.',
  },
  {
    title: 'Automation',
    body: 'We remove manual steps from processes that repeat. Moving data between systems, generating reports, sending notifications, connecting services that do not integrate out of the box.',
  },
  {
    title: 'AI agents',
    body: 'Agents that take over routine work. Processing documents, answering questions from a company knowledge base, sorting and preparing incoming requests.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-24 md:pt-52 md:pb-32">
    <p
      class="text-muted mb-6 text-[13px] font-medium tracking-[0.14em] uppercase"
    >
      TechAndDev LLC, Colorado
    </p>
    <h1
      class="max-w-4xl text-5xl leading-[1.05] font-semibold tracking-[-0.035em] text-balance md:text-7xl"
    >
      Software, automation and AI agents.
    </h1>
    <p class="text-muted mt-8 max-w-2xl text-lg leading-relaxed md:text-xl">
      {SITE.legalName} builds applications for desktop and mobile, automates business
      processes and develops AI agents. We work on our own products and on projects
      for clients.
    </p>
    <div class="mt-11 flex flex-wrap items-center gap-3">
      <a
        href="/products"
        class="bg-ink text-canvas rounded-full px-7 py-3.5 text-[15px] font-medium transition-opacity hover:opacity-85"
      >
        View products
      </a>
      <a
        href="/about"
        class="border-line bg-canvas text-ink hover:bg-surface rounded-full border px-7 py-3.5 text-[15px] font-medium transition-colors"
      >
        About the company
      </a>
    </div>
  </section>

  <!-- Services -->
  <section class="border-line bg-surface/40 border-y">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <h2
        class="max-w-2xl text-3xl leading-tight font-semibold tracking-[-0.025em] md:text-4xl"
      >
        What we do.
      </h2>
      <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
        {
          services.map((item, i) => (
            <div>
              <span class="text-muted text-[13px] font-medium tracking-wider">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">
                {item.title}
              </h3>
              <p class="text-muted mt-3 text-[15px] leading-relaxed">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div
      class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h2
          class="text-3xl leading-tight font-semibold tracking-[-0.025em] md:text-4xl"
        >
          Our products.
        </h2>
        <p class="text-muted mt-4 max-w-xl text-[17px] leading-relaxed">
          Applications we develop and publish under our own name.
        </p>
      </div>
      <a
        href="/products"
        class="text-ink text-[15px] font-medium underline underline-offset-4 transition-opacity hover:opacity-60"
      >
        All products
      </a>
    </div>

    <div
      class:list={[
        'mt-12 grid gap-6',
        PRODUCTS.length > 1 ? 'md:grid-cols-2' : 'md:grid-cols-1',
      ]}
    >
      {PRODUCTS.map((product) => <ProductCard {...product} />)}
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div
      class="border-line bg-surface/60 rounded-2xl border px-8 py-16 text-center md:px-16 md:py-20"
    >
      <h2
        class="mx-auto max-w-2xl text-3xl leading-tight font-semibold tracking-[-0.025em] text-balance md:text-4xl"
      >
        Have a project or a question?
      </h2>
      <p class="text-muted mx-auto mt-5 max-w-xl text-[17px] leading-relaxed">
        Write to us and we will reply within two business days.
      </p>
      <a
        href="/support"
        class="bg-ink text-canvas mt-9 inline-block rounded-full px-7 py-3.5 text-[15px] font-medium transition-opacity hover:opacity-85"
      >
        Get in touch
      </a>
    </div>
  </section>
</Base>
