---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../consts';

const topics = [
  {
    title: 'Product support',
    body: 'Something not working as it should? Tell us which application and version you are using, your operating system version, and what you expected to happen.',
  },
  {
    title: 'Projects and estimates',
    body: 'Describe the task. We will tell you whether we can take it on, roughly how long it would take and what it would cost.',
  },
  {
    title: 'Feature requests',
    body: 'We keep a list of these and read all of it. A description of the problem you are trying to solve is more useful to us than a proposed solution.',
  },
  {
    title: 'Privacy and legal',
    body: 'Questions about how we handle data, and requests relating to your personal information, go to the same address.',
  },
];
---

<Base
  title="Support"
  description={`Contact ${SITE.legalName} about products, projects or support.`}
>
  <PageHeader
    eyebrow="Support"
    title="Get in touch."
    lead="Messages go straight to the people who do the work. We answer within two business days."
  />

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div
      class="border-line bg-surface/60 rounded-2xl border px-8 py-12 md:px-14 md:py-16"
    >
      <p class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase">
        Email us
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-4 inline-block text-2xl font-semibold tracking-tight underline underline-offset-[6px] transition-opacity hover:opacity-60 md:text-4xl"
      >
        {SITE.email}
      </a>
      <p class="text-muted mt-6 text-[15px] leading-relaxed">
        {SITE.legalName}, {SITE.location}
      </p>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-12">
      {
        topics.map((topic) => (
          <div>
            <h2 class="text-xl font-semibold tracking-tight">{topic.title}</h2>
            <p class="text-muted mt-3 text-[15px] leading-relaxed">
              {topic.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
