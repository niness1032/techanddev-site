---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../consts';

const topics = [
  {
    title: 'Product support',
    body: 'Something not working as it should? Tell us which application and version you are using, your macOS or iOS version, and what you expected to happen.',
  },
  {
    title: 'Feature requests',
    body: 'We keep a list and read all of it. Concrete descriptions of the problem you are trying to solve are more useful to us than proposed solutions.',
  },
  {
    title: 'Privacy and legal',
    body: 'Questions about how we handle data, or requests relating to your personal information, go to the same address and are answered by a person.',
  },
  {
    title: 'Business enquiries',
    body: 'Partnerships, press, licensing and everything else that is not covered above.',
  },
];
---

<Base
  title="Support"
  description={`Contact ${SITE.legalName} for product support, feature requests or business enquiries.`}
>
  <PageHeader
    eyebrow="Support"
    title="Talk to the people who build the software."
    lead="There is no ticket system and no chatbot. Messages go straight to the team and are usually answered within two business days."
  />

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div
      class="border-line bg-surface/60 rounded-2xl border px-8 py-12 md:px-14 md:py-16"
    >
      <p class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase">
        Email us
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-4 inline-block text-2xl font-semibold tracking-tight underline underline-offset-[6px] transition-opacity hover:opacity-60 md:text-4xl"
      >
        {SITE.email}
      </a>
      <p class="text-muted mt-6 text-[15px] leading-relaxed">
        {SITE.legalName} &middot; {SITE.location}
      </p>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-12">
      {
        topics.map((topic) => (
          <div>
            <h2 class="text-xl font-semibold tracking-tight">{topic.title}</h2>
            <p class="text-muted mt-3 text-[15px] leading-relaxed">
              {topic.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>
</Base>
