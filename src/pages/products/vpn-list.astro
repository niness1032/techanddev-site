---
/**
 * PRODUCT PAGE — PLACEHOLDER.
 *
 * The copy below is deliberately short and honest: the app is in development.
 * Before submitting the site with an App Store review, fill in:
 *   1. a real feature list (3–5 items),
 *   2. at least one screenshot in /public/screenshots/,
 *   3. system requirements,
 *   4. the download or App Store link.
 */
import Base from '../../layouts/Base.astro';
import { PRODUCTS, SITE } from '../../consts';

const product = PRODUCTS.find((p) => p.slug === 'vpn-list')!;
---

<Base
  title={product.name}
  description={`${product.name} — ${product.tagline} A macOS utility by ${SITE.legalName}.`}
>
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-16 md:pt-48">
    <a
      href="/products"
      class="text-muted text-[14px] transition-opacity hover:opacity-60"
      >&larr; Products</a
    >

    <div class="mt-8 flex flex-wrap items-center gap-2.5">
      <span
        class="border-line bg-surface text-muted rounded-full border px-3 py-1 text-[12px] font-medium"
        >{product.platform}</span
      >
      <span
        class="bg-ink text-canvas rounded-full px-3 py-1 text-[12px] font-medium"
        >{product.status}</span
      >
    </div>

    <h1
      class="mt-7 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-[-0.03em] text-balance md:text-6xl"
    >
      {product.name}
    </h1>
    <p class="text-muted mt-7 max-w-2xl text-lg leading-relaxed md:text-xl">
      {product.tagline}
    </p>
  </section>

  <!-- Screenshot placeholder — replace with a real image once the app has a UI. -->
  <section class="mx-auto max-w-6xl px-6">
    <div
      class="border-line bg-surface/60 flex aspect-[16/9] items-center justify-center rounded-2xl border"
    >
      <p class="text-muted text-[14px]">Screenshots coming soon</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="grid gap-14 md:grid-cols-3">
      <div class="md:col-span-2">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          In development
        </h2>
        <p class="text-muted mt-5 max-w-2xl text-[17px] leading-relaxed">
          {product.summary}
        </p>
        <p class="text-muted mt-5 max-w-2xl text-[17px] leading-relaxed">
          {product.name} is being built right now. Detailed features, screenshots
          and system requirements will appear on this page ahead of the first release.
          If you would like to be notified when it ships, or you want to take part
          in beta testing, send us a note.
        </p>
        <a
          href="/support"
          class="bg-ink text-canvas mt-9 inline-block rounded-full px-7 py-3.5 text-[15px] font-medium transition-opacity hover:opacity-85"
        >
          Ask about the beta
        </a>
      </div>

      <aside class="border-line bg-surface/50 rounded-2xl border p-8">
        <h3
          class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase"
        >
          At a glance
        </h3>
        <dl class="mt-6 space-y-5 text-[15px]">
          <div>
            <dt class="text-muted">Platform</dt>
            <dd class="mt-1 font-medium">{product.platform}</dd>
          </div>
          <div>
            <dt class="text-muted">Status</dt>
            <dd class="mt-1 font-medium">{product.status}</dd>
          </div>
          <div>
            <dt class="text-muted">Distribution</dt>
            <dd class="mt-1 font-medium">Mac App Store</dd>
          </div>
          <div>
            <dt class="text-muted">Developer</dt>
            <dd class="mt-1 font-medium">{SITE.legalName}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>
