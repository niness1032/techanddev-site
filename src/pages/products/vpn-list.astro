---
/**
 * PRODUCT PAGE.
 *
 * The application is still in development. Before submitting the site for an
 * Apple review, add:
 *   1. at least one screenshot in /public/screenshots/,
 *   2. system requirements (minimum macOS version),
 *   3. the download or App Store link.
 */
import Base from '../../layouts/Base.astro';
import { PRODUCTS, SITE } from '../../consts';

const product = PRODUCTS.find((p) => p.slug === 'vpn-list')!;

const features = [
  {
    title: 'Several profiles at once',
    body: 'Connect more than one profile at the same time instead of switching between them one by one.',
  },
  {
    title: 'WireGuard, OpenVPN and more',
    body: 'Support for the protocols people actually use, handled by a single application rather than several.',
  },
  {
    title: 'Every profile in one list',
    body: 'All connections in one place, with the state of each one visible at a glance.',
  },
];
---

<Base
  title={product.name}
  description={`${product.name}. ${product.tagline} A macOS application by ${SITE.legalName}.`}
>
  <section class="mx-auto max-w-6xl px-6 pt-40 pb-16 md:pt-48">
    <a
      href="/products"
      class="text-muted text-[14px] transition-opacity hover:opacity-60"
      >Back to products</a
    >

    <div class="mt-8 flex flex-wrap items-center gap-2.5">
      <span
        class="border-line bg-surface text-muted rounded-full border px-3 py-1 text-[12px] font-medium"
        >{product.platform}</span
      >
      <span
        class="bg-ink text-canvas rounded-full px-3 py-1 text-[12px] font-medium"
        >{product.status}</span
      >
    </div>

    <h1
      class="mt-7 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-[-0.03em] text-balance md:text-6xl"
    >
      {product.name}
    </h1>
    <p class="text-muted mt-7 max-w-2xl text-lg leading-relaxed md:text-xl">
      {product.tagline}
    </p>
  </section>

  <!-- Screenshot placeholder. Replace with a real image once the app has a UI. -->
  <section class="mx-auto max-w-6xl px-6">
    <div
      class="border-line bg-surface/60 flex aspect-[16/9] items-center justify-center rounded-2xl border"
    >
      <p class="text-muted text-[14px]">Screenshots coming soon</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="grid gap-14 md:grid-cols-3">
      <div class="md:col-span-2">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          What it does
        </h2>
        <p class="text-muted mt-5 max-w-2xl text-[17px] leading-relaxed">
          {product.summary}
        </p>

        <div class="mt-12 space-y-10">
          {
            features.map((feature) => (
              <div class="max-w-2xl">
                <h3 class="text-xl font-semibold tracking-tight">
                  {feature.title}
                </h3>
                <p class="text-muted mt-3 text-[16px] leading-relaxed">
                  {feature.body}
                </p>
              </div>
            ))
          }
        </div>

        <div class="border-line mt-12 max-w-2xl border-t pt-8">
          <p class="text-muted text-[16px] leading-relaxed">
            The application is in development. Screenshots, system requirements
            and a release date will appear on this page as the work progresses.
            Write to us if you want to know when it ships or take part in
            testing.
          </p>
          <a
            href="/support"
            class="bg-ink text-canvas mt-8 inline-block rounded-full px-7 py-3.5 text-[15px] font-medium transition-opacity hover:opacity-85"
          >
            Ask about testing
          </a>
        </div>
      </div>

      <aside class="border-line bg-surface/50 h-fit rounded-2xl border p-8">
        <h3
          class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase"
        >
          At a glance
        </h3>
        <dl class="mt-6 space-y-5 text-[15px]">
          <div>
            <dt class="text-muted">Platform</dt>
            <dd class="mt-1 font-medium">{product.platform}</dd>
          </div>
          <div>
            <dt class="text-muted">Protocols</dt>
            <dd class="mt-1 font-medium">WireGuard, OpenVPN and others</dd>
          </div>
          <div>
            <dt class="text-muted">Status</dt>
            <dd class="mt-1 font-medium">{product.status}</dd>
          </div>
          <div>
            <dt class="text-muted">Developer</dt>
            <dd class="mt-1 font-medium">{SITE.legalName}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>
