---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../consts';
---

<Base
  title="Products"
  description="Applications developed and published by TechAndDev LLC."
>
  <PageHeader
    eyebrow="Products"
    title="Applications we develop and publish."
    lead="These are our own products. Every one of them is designed, built and supported in house."
  />

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="grid gap-6 md:grid-cols-2">
      {PRODUCTS.map((product) => <ProductCard {...product} />)}

      <div
        class="border-line flex flex-col justify-center rounded-2xl border border-dashed p-10 text-center"
      >
        <h3 class="text-xl font-semibold tracking-tight">More products</h3>
        <p class="text-muted mx-auto mt-3 max-w-xs text-[15px] leading-relaxed">
          Other applications are in development. Write to us if you want to hear
          about them when they are ready.
        </p>
        <a
          href="/support"
          class="text-ink mt-6 text-[14px] font-medium underline underline-offset-4 transition-opacity hover:opacity-60"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
</Base>
