---
/**
 * MYNOTE PRIVACY POLICY.
 * This is the URL that goes into App Store Connect as the Privacy Policy URL.
 * TODO: replace the support address once the mailbox on the company domain exists.
 */
import Base from '../../layouts/Base.astro';
import MyNoteNav from '../../components/MyNoteNav.astro';
import { SITE } from '../../consts';

const updated = 'October 19, 2026';
---

<Base
  title="MyNote Privacy Policy"
  description="MyNote collects no data. Your notes stay on your devices and in your own iCloud account."
>
  <MyNoteNav />

  <section class="mx-auto max-w-3xl px-6 pt-20 pb-8 md:pt-24">
    <p class="text-muted text-[13px] font-medium tracking-[0.14em] uppercase">
      Last updated {updated}
    </p>
    <h1
      class="mt-5 text-4xl leading-[1.08] font-semibold tracking-[-0.03em] md:text-5xl"
    >
      MyNote Privacy Policy
    </h1>

    <div class="legal mt-10">
      <p>
        MyNote is made by {SITE.legalName} ("we"). This policy explains what happens
        to your data when you use MyNote on iPhone, iPad, Mac and Apple Watch.
      </p>

      <h2>The short version</h2>
      <p>
        We don't collect any data. Your notes stay on your devices and in your
        own iCloud account. We can't see them.
      </p>

      <h2>Your notes</h2>
      <ul>
        <li>Notes, lists and drawings are stored on your devices.</li>
        <li>
          If you're signed in to iCloud, MyNote syncs your notes between your
          devices using Apple's iCloud (CloudKit, private database). This data
          is stored by Apple in your iCloud account under Apple's privacy
          policy. We have no access to it.
        </li>
        <li>
          MyNote widgets, including watch face widgets, read your notes from the
          same storage on your device.
        </li>
      </ul>

      <h2>What we don't do</h2>
      <ul>
        <li>No accounts or sign-up.</li>
        <li>No analytics, tracking or advertising.</li>
        <li>No third-party SDKs.</li>
        <li>
          No servers of our own: your notes are never sent to us or to anyone
          else.
        </li>
      </ul>

      <h2>Settings</h2>
      <p>
        Your preferences (theme, font, sort order) are stored on your device
        only.
      </p>

      <h2>Deleting your data</h2>
      <p>
        Delete a note in the app to remove it from all your devices and iCloud.
        Deleting the app removes its local data. To remove MyNote data from
        iCloud: Settings, then your name, then iCloud, then Manage Storage on
        iPhone and iPad. On Mac: System Settings, then Apple Account, then
        iCloud, then Manage.
      </p>

      <h2>Children</h2>
      <p>
        MyNote doesn't collect any personal information from anyone, including
        children.
      </p>

      <h2>Changes</h2>
      <p>If this policy changes, we'll update this page and the date above.</p>

      <h2>Contact</h2>
      <p>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
  </section>
</Base>
